---
import fs from "node:fs";
import path from "node:path";

import "../styles/global.css";
import { homepageConfig } from "../lib/homepage-config";
import type { AssetItem, SiteSummary } from "../lib/types";

const dataDir = path.join(process.cwd(), "public", "data");
const homeStyle = [
  `--site-max-width: ${homepageConfig.theme.maxWidth}`,
  `--hero-min-height: ${homepageConfig.theme.heroMinHeight}`,
  `--hero-title-max: ${homepageConfig.theme.heroTitleMax}`,
  `--accent: ${homepageConfig.theme.accent}`,
  `--accent-strong: ${homepageConfig.theme.accentStrong}`,
  `--bili: ${homepageConfig.theme.bilibiliPink}`,
].join(";");

const summary = readJson<SiteSummary>("summary.json", {
  totalAssets: 0,
  games: [],
  generatedAt: new Date(0).toISOString(),
});
const recentUpdates = readJson<AssetItem[]>("recent-updates.json", []).slice(0, 8);

const gameStats = new Map(summary.games.map((game) => [game.game, game]));
const arcaea = gameStats.get("Arcaea");
const phigros = gameStats.get("Phigros");
const categoryShortcuts = getCategoryShortcuts(summary);
const generatedAt = new Intl.DateTimeFormat("zh-CN", {
  year: "numeric",
  month: "2-digit",
  day: "2-digit",
  hour: "2-digit",
  minute: "2-digit",
}).format(new Date(summary.generatedAt));

function readJson<T>(filename: string, fallback: T): T {
  const filePath = path.join(dataDir, filename);
  if (!fs.existsSync(filePath)) {
    return fallback;
  }
  return JSON.parse(fs.readFileSync(filePath, "utf8")) as T;
}

function getCategoryShortcuts(siteSummary: SiteSummary) {
  const counts = new Map<string, number>();

  for (const game of siteSummary.games) {
    if (game.game === "Unknown") {
      continue;
    }
    for (const [category, count] of Object.entries(game.categories)) {
      counts.set(category, (counts.get(category) ?? 0) + count);
    }
  }

  return [...counts.entries()]
    .map(([name, count]) => ({ name, count, href: `/search?category=${encodeURIComponent(name)}` }))
    .sort((a, b) => b.count - a.count || a.name.localeCompare(b.name))
    .slice(0, 10);
}

function formatBytes(bytes?: number) {
  if (!bytes) {
    return homepageConfig.sections.unknownSize;
  }
  if (bytes < 1024 * 1024) {
    return `${Math.round(bytes / 1024)} KB`;
  }
  return `${(bytes / 1024 / 1024).toFixed(1)} MB`;
}
---

<!doctype html>
<html lang="zh-CN">
  <head>
    <meta charset="utf-8" />
    <link rel="icon" type="image/svg+xml" href="/favicon.svg" />
    <link rel="icon" href="/favicon.ico" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <meta name="generator" content={Astro.generator} />
    <meta name="description" content={homepageConfig.metaDescription} />
    <title>{homepageConfig.siteTitle}</title>
  </head>
  <body>
    <main class="site-shell" style={homeStyle}>
      <section class="hero">
        <div class="hero-copy">
          <p class="eyebrow">{homepageConfig.hero.eyebrow}</p>
          <h1>{homepageConfig.hero.title}</h1>
          <p class="hero-text">{homepageConfig.hero.description}</p>

          <form class="search-entry" action="/search" method="get">
            <label class="sr-only" for="home-search">{homepageConfig.hero.searchLabel}</label>
            <input id="home-search" name="q" type="search" placeholder={homepageConfig.hero.searchPlaceholder} />
            <button type="submit">{homepageConfig.hero.searchButton}</button>
          </form>
        </div>

        <aside class="hero-side" aria-label="站点信息">
          {
            homepageConfig.bilibili.enabled && (
              <div class="owner-card">
                <span class="bili-mark">{homepageConfig.bilibili.badge}</span>
                <strong>{homepageConfig.bilibili.title}</strong>
                <span>{homepageConfig.bilibili.description}</span>
                <a href={homepageConfig.bilibili.url} target="_blank" rel="noopener noreferrer">
                  {homepageConfig.bilibili.button}
                </a>
              </div>
            )
          }

          <div class="quick-stats" aria-label="资源统计">
            <div>
              <span class="stat-value">{summary.totalAssets.toLocaleString("zh-CN")}</span>
              <span class="stat-label">{homepageConfig.stats.totalAssetsLabel}</span>
            </div>
            <div>
              <span class="stat-value">{categoryShortcuts.length}</span>
              <span class="stat-label">{homepageConfig.stats.categoryShortcutLabel}</span>
            </div>
          </div>
        </aside>
      </section>

      <section class="game-grid" aria-label="游戏入口">
        <a class="game-card arcaea-card" href="/arcaea">
          <span class="card-kicker">Arcaea</span>
          <strong>{arcaea?.totalAssets.toLocaleString("zh-CN") ?? 0} 张</strong>
          <span>{Object.keys(arcaea?.categories ?? {}).length} {homepageConfig.games.arcaeaDescription}</span>
        </a>

        <a class="game-card phigros-card" href="/phigros">
          <span class="card-kicker">Phigros</span>
          <strong>{phigros?.totalAssets.toLocaleString("zh-CN") ?? 0} 张</strong>
          <span>{Object.keys(phigros?.categories ?? {}).length} {homepageConfig.games.phigrosDescription}</span>
        </a>
      </section>

      <section class="section-block">
        <div class="section-heading">
          <p class="eyebrow">{homepageConfig.sections.categoriesEyebrow}</p>
          <h2>{homepageConfig.sections.categoriesTitle}</h2>
        </div>
        <div class="category-list">
          {
            categoryShortcuts.map((category) => (
              <a href={category.href} class="category-chip">
                <span>{category.name}</span>
                <strong>{category.count}</strong>
              </a>
            ))
          }
        </div>
      </section>

      <section class="section-block">
        <div class="section-heading split-heading">
          <div>
            <p class="eyebrow">{homepageConfig.sections.recentEyebrow}</p>
            <h2>{homepageConfig.sections.recentTitle}</h2>
          </div>
          <span class="muted">{homepageConfig.sections.generatedPrefix}{generatedAt}</span>
        </div>

        <div class="recent-grid">
          {
            recentUpdates.map((asset) => (
              <a class="asset-card" href={`/asset/${asset.id}`}>
                <img
                  src={asset.thumbnailSmall ?? asset.thumbnailMedium}
                  alt={asset.title}
                  loading="lazy"
                  decoding="async"
                  width={asset.width ?? 320}
                  height={asset.height ?? 240}
                />
                <span class="asset-meta">{asset.game} / {asset.category}</span>
                <strong>{asset.title}</strong>
                <span>{formatBytes(asset.sizeBytes)}</span>
              </a>
            ))
          }
        </div>
      </section>

      <section class="section-block stats-band">
        <div>
          <p class="eyebrow">{homepageConfig.sections.overviewEyebrow}</p>
          <h2>{homepageConfig.sections.overviewTitle}</h2>
        </div>
        <div class="stats-grid">
          {
            summary.games
              .filter((game) => game.game !== "Unknown" || game.totalAssets > 0)
              .map((game) => (
                <div class="mini-stat">
                  <span>{game.game}</span>
                  <strong>{game.totalAssets.toLocaleString("zh-CN")}</strong>
                  <small>{Object.keys(game.categories).length} {homepageConfig.sections.categoryUnit}</small>
                </div>
              ))
          }
        </div>
      </section>
    </main>
  </body>
</html>

<style>
  :global(:root) {
    color-scheme: light dark;
    --bg: #f6f7fb;
    --surface: #ffffff;
    --surface-soft: #eef2f7;
    --text: #111827;
    --muted: #667085;
    --line: #d9e0ea;
    --accent: #0f766e;
    --accent-strong: #0f4f66;
    --bili: #fb7299;
    --shadow: 0 18px 42px rgba(16, 24, 40, 0.1);
  }

  :global(body) {
    background:
      radial-gradient(circle at top left, rgba(20, 184, 166, 0.13), transparent 31rem),
      linear-gradient(180deg, var(--bg), #ffffff 42rem);
    color: var(--text);
  }

  .site-shell {
    width: min(var(--site-max-width), calc(100% - 32px));
    margin: 0 auto;
    padding: 30px 0 56px;
  }

  .hero {
    display: grid;
    grid-template-columns: minmax(0, 1.25fr) minmax(280px, 0.75fr);
    gap: 20px;
    align-items: stretch;
  }

  .hero-copy,
  .owner-card,
  .quick-stats,
  .game-card,
  .section-block,
  .asset-card {
    border: 1px solid var(--line);
    background: color-mix(in srgb, var(--surface) 92%, transparent);
    box-shadow: var(--shadow);
  }

  .hero-copy {
    display: flex;
    min-height: var(--hero-min-height);
    flex-direction: column;
    justify-content: center;
    border-radius: 22px;
    padding: clamp(26px, 5vw, 56px);
  }

  .eyebrow {
    margin: 0 0 10px;
    color: var(--accent);
    font-size: 0.78rem;
    font-weight: 800;
    letter-spacing: 0.08em;
    text-transform: uppercase;
  }

  h1,
  h2,
  p {
    margin-top: 0;
  }

  h1 {
    max-width: 680px;
    margin-bottom: 16px;
    font-size: clamp(2.15rem, 4.6vw, var(--hero-title-max));
    line-height: 1.02;
    letter-spacing: 0;
  }

  h2 {
    margin-bottom: 0;
    font-size: clamp(1.35rem, 2.4vw, 2rem);
    line-height: 1.15;
    letter-spacing: 0;
  }

  .hero-text {
    max-width: 680px;
    margin-bottom: 26px;
    color: var(--muted);
    font-size: 1rem;
    line-height: 1.8;
  }

  .search-entry {
    display: flex;
    width: min(640px, 100%);
    gap: 10px;
    padding: 8px;
    border: 1px solid var(--line);
    border-radius: 999px;
    background: var(--surface);
  }

  .search-entry input {
    min-width: 0;
    flex: 1;
    border: 0;
    padding: 0 18px;
    background: transparent;
    color: var(--text);
    font: inherit;
    outline: none;
  }

  .search-entry button {
    min-height: 46px;
    border: 0;
    border-radius: 999px;
    padding: 12px 22px;
    background: var(--text);
    color: var(--surface);
    font: inherit;
    font-weight: 800;
    cursor: pointer;
  }

  .hero-side {
    display: grid;
    grid-template-rows: 1fr auto;
    gap: 20px;
  }

  .owner-card {
    display: flex;
    min-height: 210px;
    flex-direction: column;
    justify-content: flex-end;
    border-radius: 22px;
    padding: 26px;
    background:
      linear-gradient(135deg, color-mix(in srgb, var(--surface) 82%, var(--bili)), var(--surface) 72%),
      var(--surface);
  }

  .bili-mark {
    width: max-content;
    margin-bottom: auto;
    border-radius: 999px;
    padding: 7px 11px;
    background: color-mix(in srgb, var(--bili) 16%, var(--surface));
    color: var(--bili);
    font-size: 0.82rem;
    font-weight: 900;
  }

  .owner-card strong {
    margin-bottom: 8px;
    font-size: 1.45rem;
    line-height: 1.18;
  }

  .owner-card span:not(.bili-mark) {
    color: var(--muted);
    line-height: 1.7;
  }

  .owner-card a {
    width: max-content;
    margin-top: 18px;
    border-radius: 999px;
    padding: 11px 16px;
    background: var(--bili);
    color: #fff;
    font-weight: 900;
    text-decoration: none;
  }

  .quick-stats {
    display: grid;
    grid-template-columns: repeat(2, minmax(0, 1fr));
    overflow: hidden;
    border-radius: 22px;
    background: var(--line);
    gap: 1px;
  }

  .quick-stats > div {
    display: flex;
    min-height: 124px;
    flex-direction: column;
    justify-content: center;
    padding: 22px;
    background: var(--surface);
  }

  .stat-value {
    font-size: clamp(1.8rem, 4vw, 3rem);
    font-weight: 900;
    line-height: 1;
  }

  .stat-label,
  .muted,
  .asset-card span,
  .game-card span,
  .mini-stat small {
    color: var(--muted);
  }

  .game-grid {
    display: grid;
    grid-template-columns: repeat(2, minmax(0, 1fr));
    gap: 20px;
    margin-top: 20px;
  }

  .game-card {
    display: flex;
    min-height: 170px;
    flex-direction: column;
    justify-content: flex-end;
    border-radius: 20px;
    padding: 26px;
    color: inherit;
    text-decoration: none;
  }

  .game-card strong {
    margin-bottom: 8px;
    font-size: clamp(1.55rem, 2.6vw, 2.15rem);
    line-height: 1.1;
  }

  .card-kicker {
    margin-bottom: auto;
    font-weight: 900;
  }

  .arcaea-card {
    background: linear-gradient(135deg, color-mix(in srgb, var(--surface) 86%, #67e8f9), var(--surface));
  }

  .phigros-card {
    background: linear-gradient(135deg, color-mix(in srgb, var(--surface) 88%, #fda4af), var(--surface));
  }

  .section-block {
    margin-top: 20px;
    border-radius: 20px;
    padding: clamp(22px, 4vw, 34px);
  }

  .section-heading {
    margin-bottom: 22px;
  }

  .split-heading {
    display: flex;
    gap: 16px;
    align-items: end;
    justify-content: space-between;
  }

  .category-list {
    display: flex;
    flex-wrap: wrap;
    gap: 10px;
  }

  .category-chip {
    display: inline-flex;
    align-items: center;
    gap: 12px;
    border: 1px solid var(--line);
    border-radius: 999px;
    padding: 10px 14px;
    background: var(--surface-soft);
    color: inherit;
    text-decoration: none;
  }

  .category-chip strong {
    color: var(--accent-strong);
  }

  .recent-grid {
    display: grid;
    grid-template-columns: repeat(4, minmax(0, 1fr));
    gap: 16px;
  }

  .asset-card {
    overflow: hidden;
    border-radius: 16px;
    color: inherit;
    text-decoration: none;
  }

  .asset-card img {
    display: block;
    width: 100%;
    aspect-ratio: 4 / 3;
    object-fit: cover;
    background: var(--surface-soft);
  }

  .asset-card strong,
  .asset-card span {
    display: block;
    padding-inline: 14px;
  }

  .asset-card strong {
    padding-top: 6px;
    overflow: hidden;
    text-overflow: ellipsis;
    white-space: nowrap;
  }

  .asset-card span:last-child {
    padding-bottom: 14px;
  }

  .asset-meta {
    padding-top: 12px;
    font-size: 0.82rem;
  }

  .stats-band {
    display: grid;
    grid-template-columns: 0.7fr 1.3fr;
    gap: 20px;
    align-items: center;
  }

  .stats-grid {
    display: grid;
    grid-template-columns: repeat(3, minmax(0, 1fr));
    gap: 12px;
  }

  .mini-stat {
    border: 1px solid var(--line);
    border-radius: 16px;
    padding: 18px;
    background: var(--surface-soft);
  }

  .mini-stat span,
  .mini-stat strong,
  .mini-stat small {
    display: block;
  }

  .mini-stat strong {
    margin: 8px 0 4px;
    font-size: 2rem;
    line-height: 1;
  }

  .sr-only {
    position: absolute;
    width: 1px;
    height: 1px;
    overflow: hidden;
    clip: rect(0, 0, 0, 0);
    white-space: nowrap;
  }

  @media (prefers-color-scheme: dark) {
    :global(:root) {
      --bg: #0d1117;
      --surface: #151b23;
      --surface-soft: #1f2937;
      --text: #f8fafc;
      --muted: #a4adbb;
      --line: #2e3746;
      --accent: #5eead4;
      --accent-strong: #7dd3fc;
      --shadow: 0 20px 50px rgba(0, 0, 0, 0.35);
    }

    :global(body) {
      background:
        radial-gradient(circle at top left, rgba(45, 212, 191, 0.12), transparent 31rem),
        linear-gradient(180deg, var(--bg), #111827 42rem);
    }
  }

  @media (max-width: 900px) {
    .hero,
    .stats-band {
      grid-template-columns: 1fr;
    }

    .hero-side {
      grid-template-columns: minmax(0, 1fr) minmax(260px, 0.85fr);
      grid-template-rows: auto;
    }

    .recent-grid {
      grid-template-columns: repeat(2, minmax(0, 1fr));
    }
  }

  @media (max-width: 620px) {
    .site-shell {
      width: min(100% - 20px, var(--site-max-width));
      padding-top: 10px;
    }

    .hero-copy,
    .owner-card,
    .quick-stats,
    .game-card,
    .section-block {
      border-radius: 16px;
    }

    .hero-copy {
      min-height: 300px;
    }

    .hero-side,
    .search-entry {
      grid-template-columns: 1fr;
    }

    .search-entry {
      align-items: stretch;
      border-radius: 18px;
      flex-direction: column;
    }

    .search-entry input {
      min-height: 46px;
    }

    .game-grid,
    .recent-grid,
    .stats-grid,
    .quick-stats {
      grid-template-columns: 1fr;
    }

    .split-heading {
      align-items: start;
      flex-direction: column;
    }
  }
</style>
