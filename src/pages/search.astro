---
import fs from "node:fs";
import path from "node:path";

import GalleryGrid from "../components/GalleryGrid";
import SiteNav from "../components/SiteNav.astro";
import "../styles/global.css";
import { SITE_NAME, absoluteUrl, assetOgImage } from "../lib/seo";
import type { AssetItem } from "../lib/types";

const assets = [...readAssets("arcaea-index.json"), ...readAssets("phigros-index.json")];
const pageTitle = "音游曲绘资源搜索 - Unknnownnn";
const pageDescription = "同时搜索 Arcaea 与 Phigros 的曲绘、立绘、封面、头像与背景图，输入关键词即可跨游戏查找。";
const pageUrl = absoluteUrl("/search/");
const pageImage = assets[0] ? assetOgImage(assets[0]) : absoluteUrl("/site-icon.png");
const navLinks = [
  { href: "/", label: "首页" },
  { href: "/arcaea", label: "Arcaea" },
  { href: "/phigros", label: "Phigros" },
  { href: "/search", label: "搜索" },
];

function readAssets(filename: string): AssetItem[] {
  const filePath = path.join(process.cwd(), "public", "data", filename);
  if (!fs.existsSync(filePath)) {
    return [];
  }
  return JSON.parse(fs.readFileSync(filePath, "utf8")) as AssetItem[];
}
---

<!doctype html>
<html lang="zh-CN">
  <head>
    <meta charset="utf-8" />
    <link rel="icon" type="image/png" href="/site-icon.png" />
    <link rel="apple-touch-icon" href="/apple-touch-icon.png" />
    <link rel="manifest" href="/site.webmanifest" />
    <link rel="canonical" href={pageUrl} />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <meta name="generator" content={Astro.generator} />
    <meta name="description" content={pageDescription} />
    <meta property="og:type" content="website" />
    <meta property="og:site_name" content={SITE_NAME} />
    <meta property="og:title" content={pageTitle} />
    <meta property="og:description" content={pageDescription} />
    <meta property="og:url" content={pageUrl} />
    <meta property="og:image" content={pageImage} />
    <title>{pageTitle}</title>
  </head>
  <body class="theme-search">
    <SiteNav links={navLinks} />

    <main class="gallery-page-shell">
      <header class="gallery-page-hero glass-panel" data-reveal>
        <p class="eyebrow">Search</p>
        <h1>全站搜索</h1>
        <div class="gallery-hero-badges">
          <span>Arcaea + Phigros 联合搜索</span>
          <span>多关键词智能匹配</span>
          <span>支持批量打包下载</span>
        </div>
      </header>

      <GalleryGrid assets={assets} game="All" client:load />
    </main>
    <script is:inline src="/search-autocomplete.js"></script>
    <script type="module" src="/site-effects.js"></script>
  </body>
</html>
