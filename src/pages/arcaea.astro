---
import fs from "node:fs";
import path from "node:path";

import GalleryGrid from "../components/GalleryGrid";
import "../styles/global.css";
import { SITE_NAME, absoluteUrl, assetOgImage } from "../lib/seo";
import type { AssetItem } from "../lib/types";

const assets = readAssets("arcaea-index.json");
const pageTitle = "Arcaea 曲绘资源下载 - Unknnownnn";
const pageDescription = "浏览和搜索 Arcaea 曲绘、曲包封面、角色立绘、剧情 CG、启动页面和游玩背景资源。";
const pageUrl = absoluteUrl("/arcaea/");
const pageImage = assets[0] ? assetOgImage(assets[0]) : absoluteUrl("/site-icon.png");

function readAssets(filename: string): AssetItem[] {
  const filePath = path.join(process.cwd(), "public", "data", filename);
  if (!fs.existsSync(filePath)) {
    return [];
  }
  return JSON.parse(fs.readFileSync(filePath, "utf8")) as AssetItem[];
}
---

<!doctype html>
<html lang="zh-CN">
  <head>
    <meta charset="utf-8" />
    <link rel="icon" type="image/png" href="/site-icon.png" />
    <link rel="apple-touch-icon" href="/apple-touch-icon.png" />
    <link rel="manifest" href="/site.webmanifest" />
    <link rel="canonical" href={pageUrl} />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <meta name="generator" content={Astro.generator} />
    <meta name="description" content={pageDescription} />
    <meta property="og:type" content="website" />
    <meta property="og:site_name" content={SITE_NAME} />
    <meta property="og:title" content={pageTitle} />
    <meta property="og:description" content={pageDescription} />
    <meta property="og:url" content={pageUrl} />
    <meta property="og:image" content={pageImage} />
    <title>{pageTitle}</title>
  </head>
  <body class="theme-arcaea">
    <main class="gallery-page-shell">
      <header class="gallery-page-hero">
        <nav>
          <a href="/">首页</a>
          <a href="/phigros">Phigros</a>
        </nav>
        <p class="eyebrow">Arcaea Gallery</p>
        <h1>Arcaea 资源图库</h1>
        <p>当前索引 {assets.length.toLocaleString("zh-CN")} 个资源。搜索和筛选仅加载 Arcaea 索引。</p>
        <p class="seo-copy">本页整理 Arcaea 曲绘、曲包封面、角色立绘、剧情 CG、启动页面、游玩背景等资源。你可以通过曲名、作者、曲包、BPM、SIDE 或版本号进行搜索。</p>
      </header>

      <GalleryGrid assets={assets} game="Arcaea" client:load />

      <footer class="gallery-footer">
        <a href="https://github.com/unknnownnn003/rhythm-assets-gallery" target="_blank" rel="noopener noreferrer">GitHub</a>
      </footer>
    </main>
  </body>
</html>
