---
import fs from "node:fs";
import path from "node:path";

import "../../styles/global.css";
import { SITE_NAME, absoluteUrl, assetAlt, assetMetaDescription, assetMetaTitle, assetOgImage } from "../../lib/seo";
import type { AssetItem } from "../../lib/types";

export function getStaticPaths() {
  const dataDir = path.join(process.cwd(), "public", "data");
  const readIndex = (filename: string): AssetItem[] => {
    const filePath = path.join(dataDir, filename);
    if (!fs.existsSync(filePath)) {
      return [];
    }
    return JSON.parse(fs.readFileSync(filePath, "utf8")) as AssetItem[];
  };
  const assets = [...readIndex("arcaea-index.json"), ...readIndex("phigros-index.json")];
  const seededScore = (value: string) => {
    let hash = 2166136261;
    for (let index = 0; index < value.length; index += 1) {
      hash ^= value.charCodeAt(index);
      hash = Math.imul(hash, 16777619);
    }
    return hash >>> 0;
  };
  const seededShuffle = <T,>(items: T[], seed: string) =>
    [...items]
      .map((item, index) => ({ item, score: seededScore(`${seed}:${index}`) }))
      .sort((a, b) => a.score - b.score)
      .map(({ item }) => item);
  const normalizeAssetKey = (value: string) =>
    value
      .replace(/\.[^.]+$/, "")
      .replace(/\.(?:jpg|jpeg|png|webp|avif|gif)_opt$/i, "")
      .replace(/_opt$/i, "")
      .normalize("NFC")
      .toLowerCase();
  const isArcaeaSongArt = (asset: AssetItem) =>
    asset.game === "Arcaea" && (asset.category === "曲绘" || asset.category === "曲绘（AI超分后）");
  const preferOriginalSongArt = (items: AssetItem[]) => {
    const groups = new Map<string, AssetItem>();
    for (const item of items) {
      if (!isArcaeaSongArt(item)) {
        groups.set(item.id, item);
        continue;
      }

      const key = normalizeAssetKey(item.filename);
      const current = groups.get(key);
      if (!current || (item.category === "曲绘" && current.category === "曲绘（AI超分后）")) {
        groups.set(key, item);
      }
    }
    return [...groups.values()];
  };
  const getRelated = (current: AssetItem) => {
    if (current.game === "Arcaea" && current.characterId !== undefined) {
      return seededShuffle(
        assets.filter((asset) => asset.id !== current.id && asset.game === current.game && asset.characterId === current.characterId),
        current.id,
      ).slice(0, 8);
    }

    if (current.game === "Arcaea" && current.storyPathTitle) {
      return seededShuffle(
        assets.filter(
          (asset) =>
            asset.id !== current.id &&
            asset.game === current.game &&
            (
              asset.storyPathTitle === current.storyPathTitle ||
              Boolean(current.relatedSongId && asset.songId === current.relatedSongId) ||
              Boolean(current.relatedCharacterIds?.some((id) => asset.characterId === id))
            ),
        ),
        current.id,
      ).slice(0, 8);
    }

    if (current.game === "Arcaea" && current.category === "游玩背景") {
      const backgroundKey = normalizeAssetKey(current.filename);
      const songsUsingBackground = assets.filter(
        (asset) =>
          asset.id !== current.id &&
          asset.game === current.game &&
          (asset.category === "曲绘" || asset.category === "曲绘（AI超分后）") &&
          asset.bg &&
          normalizeAssetKey(asset.bg) === backgroundKey,
      );

      return seededShuffle(preferOriginalSongArt(songsUsingBackground), current.id).slice(0, 8);
    }

    const samePack = current.pack
      ? assets.filter((asset) => asset.id !== current.id && asset.game === current.game && asset.pack === current.pack)
      : [];

    if (current.pack) {
      return seededShuffle(preferOriginalSongArt(samePack), current.id).slice(0, 8);
    }

    return seededShuffle(
      preferOriginalSongArt(
        assets.filter(
          (asset) =>
            asset.id !== current.id &&
            asset.game === current.game &&
            asset.category === current.category,
        ),
      ),
      current.id,
    )
      .slice(0, 8);
  };
  const getBackgroundAsset = (current: AssetItem) => {
    if (!current.bg) {
      return undefined;
    }

    const expected = normalizeAssetKey(current.bg);
    return assets.find(
      (asset) =>
        asset.id !== current.id &&
        asset.game === current.game &&
        asset.category === "游玩背景" &&
        normalizeAssetKey(asset.filename) === expected,
    );
  };
  const getAlternateSongArt = (current: AssetItem) => {
    if (!isArcaeaSongArt(current)) {
      return undefined;
    }

    const expected = normalizeAssetKey(current.filename);
    const expectedCategory = current.category === "曲绘" ? "曲绘（AI超分后）" : "曲绘";
    return assets.find(
      (asset) =>
        asset.id !== current.id &&
        asset.game === current.game &&
        asset.category === expectedCategory &&
        normalizeAssetKey(asset.filename) === expected,
    );
  };

  return assets.map((asset) => ({
    params: { id: asset.id },
    props: {
      asset,
      relatedAssets: getRelated(asset),
      backgroundAsset: getBackgroundAsset(asset),
      alternateSongArt: getAlternateSongArt(asset),
    },
  }));
}

type Props = {
  asset: AssetItem;
  relatedAssets: AssetItem[];
  backgroundAsset?: AssetItem;
  alternateSongArt?: AssetItem;
};

const { asset, relatedAssets, backgroundAsset, alternateSongArt } = Astro.props as Props;
const previewUrl = asset.thumbnailLarge ?? asset.thumbnailMedium ?? asset.thumbnailSmall ?? asset.url;
const gameHref = asset.game === "Phigros" ? "/phigros" : "/arcaea";
const gameLabel = asset.game === "Phigros" ? "返回 Phigros" : "返回 Arcaea";
const originalUrl = asset.url;
const fileSize = formatBytes(asset.sizeBytes);
const dimensions = asset.width && asset.height ? `${asset.width} x ${asset.height}` : "未知尺寸";
const packLabel = asset.packDisplayName ?? asset.pack;
const wikiLabel = "Arcaea Wiki";
const pageTitle = assetMetaTitle(asset);
const pageDescription = assetMetaDescription(asset);
const pageUrl = absoluteUrl(`/asset/${asset.id}/`);
const pageImage = assetOgImage(asset);
const previewAlt = assetAlt(asset);
const relatedHeading = asset.category === "游玩背景"
  ? "使用该背景的曲目"
  : asset.characterId !== undefined
    ? "同搭档相关资源"
    : asset.storyPathTitle
      ? "同剧情章节资源"
      : asset.pack
        ? "同曲包随机推荐"
        : "同分类推荐";
const metadataRows = [
  { label: "游戏", value: asset.game },
  { label: "分类", value: asset.category },
  { label: "歌曲 ID", value: asset.songId },
  { label: "作者", value: asset.artist },
  { label: "曲包", value: packLabel },
  { label: "版本", value: asset.version },
  { label: "独立难度曲绘", value: asset.difficultyLabel ?? asset.difficulty },
  { label: "显示难度", value: asset.difficultyRating },
  { label: "全部谱面难度", value: asset.difficultyRatings?.join(" / ") },
  { label: "谱师", value: asset.chartDesigner },
  { label: "曲绘画师", value: asset.jacketDesigner },
  { label: "BYD 版本", value: asset.bydVersion },
  { label: "ETR 版本", value: asset.etrVersion },
  { label: "BPM", value: asset.bpm },
  { label: "侧别", value: asset.sideLabel ?? asset.side },
  { label: "游玩背景", value: asset.bg, href: backgroundAsset ? `/asset/${backgroundAsset.id}` : undefined },
  { label: "反转背景", value: asset.bgInverse },
  { label: "搭档", value: asset.characterName },
  { label: "搭档英文名", value: asset.characterEnglishName },
  { label: "搭档资源", value: asset.characterVariant },
  { label: "关联角色", value: asset.relatedCharacterNames?.join(" / ") },
  { label: "剧情章节", value: asset.storyPathTitle },
  { label: "剧情节点", value: asset.storyNode },
  { label: "剧情类型", value: asset.storyType },
  { label: "关联曲目", value: asset.relatedSongTitle ?? asset.relatedSongId },
  { label: "文件名", value: asset.filename },
  { label: "文件大小", value: fileSize },
  { label: "图片尺寸", value: dimensions },
  { label: wikiLabel, value: asset.wikiUrl ? "打开对应页面" : undefined, href: asset.wikiUrl },
].filter((row) => row.value !== undefined && row.value !== "");

function formatBytes(bytes?: number) {
  if (!bytes) {
    return "未知大小";
  }
  if (bytes < 1024 * 1024) {
    return `${Math.round(bytes / 1024)} KB`;
  }
  return `${(bytes / 1024 / 1024).toFixed(1)} MB`;
}

---

<!doctype html>
<html lang="zh-CN">
  <head>
    <meta charset="utf-8" />
    <link rel="icon" type="image/png" href="/site-icon.png" />
    <link rel="apple-touch-icon" href="/apple-touch-icon.png" />
    <link rel="manifest" href="/site.webmanifest" />
    <link rel="canonical" href={pageUrl} />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <meta name="generator" content={Astro.generator} />
    <meta name="description" content={pageDescription} />
    <meta property="og:type" content="article" />
    <meta property="og:site_name" content={SITE_NAME} />
    <meta property="og:title" content={pageTitle} />
    <meta property="og:description" content={pageDescription} />
    <meta property="og:url" content={pageUrl} />
    <meta property="og:image" content={pageImage} />
    <title>{pageTitle}</title>
  </head>
  <body class={asset.game === "Phigros" ? "theme-phigros" : "theme-arcaea"}>
    <main class="detail-shell">
      <nav class="top-nav" aria-label="页面导航">
        <a href="/">首页</a>
        <a href={gameHref}>{gameLabel}</a>
        <a href="/search">全站搜索</a>
      </nav>

      <section class="detail-hero">
        <div class="preview-panel">
          <img
            src={previewUrl}
            alt={previewAlt}
            width={asset.width ?? 1280}
            height={asset.height ?? 720}
            loading="lazy"
            decoding="async"
          />
        </div>

        <div class="info-panel">
          <p class="eyebrow">{asset.game} / {asset.category}</p>
          <h1>{asset.title}</h1>

          <div class="action-row">
            <a class="primary-action" href={originalUrl} download={asset.filename}>下载原图</a>
            <button class="secondary-action" type="button" data-copy-url={originalUrl}>复制直链</button>
            {asset.wikiUrl ? <a class="secondary-action" href={asset.wikiUrl} target="_blank" rel="noreferrer">{wikiLabel}</a> : null}
            <a class="secondary-action" href={gameHref}>{gameLabel}</a>
          </div>

          {
            alternateSongArt ? (
              <div class="variant-switch" aria-label="曲绘版本切换">
                <span>曲绘版本</span>
                <div>
                  {asset.category === "曲绘" ? (
                    <strong>原图</strong>
                  ) : (
                    <a href={`/asset/${alternateSongArt.id}`}>原图</a>
                  )}
                  {asset.category === "曲绘（AI超分后）" ? (
                    <strong>AI 超分</strong>
                  ) : (
                    <a href={`/asset/${alternateSongArt.id}`}>AI 超分</a>
                  )}
                </div>
              </div>
            ) : null
          }

          <dl class="metadata-list">
            {
              metadataRows.map((row) => (
                <>
                  <dt>{row.label}</dt>
                  <dd>{row.href ? <a class="metadata-link" href={row.href}>{row.value}</a> : row.value}</dd>
                </>
              ))
            }
          </dl>

          <div class="tag-list" aria-label="标签">
            {asset.tags.map((tag) => <a href={`/search?tag=${encodeURIComponent(tag)}`}>{tag}</a>)}
          </div>
        </div>
      </section>

      <section class="related-section">
        <div class="section-heading">
          <p class="eyebrow">Related</p>
          <h2>{relatedHeading}</h2>
        </div>

        {
          relatedAssets.length > 0 ? (
            <div class="related-grid">
              {relatedAssets.map((related) => (
                <a class="related-card" href={`/asset/${related.id}`}>
                  <img
                    src={related.thumbnailSmall ?? related.thumbnailMedium ?? related.thumbnailLarge}
                    alt={assetAlt(related)}
                    width={related.width ?? 320}
                    height={related.height ?? 240}
                    loading="lazy"
                    decoding="async"
                  />
                  <span>{related.category}</span>
                  <strong>{related.title}</strong>
                </a>
              ))}
            </div>
          ) : (
            <p class="empty-related">暂无可推荐的同类资源。</p>
          )
        }
      </section>
    </main>

    <script>
      const button = document.querySelector("[data-copy-url]");
      button?.addEventListener("click", async () => {
        const url = new URL(button.getAttribute("data-copy-url") || "", window.location.origin).toString();
        try {
          await navigator.clipboard.writeText(url);
          button.textContent = "已复制";
          window.setTimeout(() => {
            button.textContent = "复制直链";
          }, 1600);
        } catch {
          button.textContent = "复制失败";
          window.setTimeout(() => {
            button.textContent = "复制直链";
          }, 1600);
        }
      });
    </script>
    <script type="module" src="/site-effects.js"></script>
  </body>
</html>

<style>
  .detail-shell {
    width: min(1320px, calc(100% - 32px));
    margin: 0 auto;
    padding: 28px 0 56px;
  }

  .top-nav {
    display: flex;
    flex-wrap: wrap;
    gap: 10px;
    margin-bottom: 18px;
  }

  .top-nav a,
  .secondary-action,
  .primary-action,
  .tag-list a {
    border: 1px solid var(--line);
    border-radius: 16px;
    color: inherit;
    font-weight: 800;
    text-decoration: none;
  }

  .top-nav a {
    padding: 8px 12px;
    background: rgba(255, 255, 255, 0.58);
    box-shadow: var(--soft-shadow);
    backdrop-filter: blur(16px) saturate(1.35);
    -webkit-backdrop-filter: blur(16px) saturate(1.35);
  }

  .top-nav a:hover {
    border-color: color-mix(in srgb, var(--accent-strong) 42%, var(--line));
    transform: translateY(-2px) scale(1.03);
  }

  .detail-hero {
    display: grid;
    grid-template-columns: minmax(0, 1.35fr) minmax(340px, 0.65fr);
    gap: 20px;
    align-items: start;
  }

  .preview-panel,
  .info-panel,
  .related-section {
    border: 1px solid var(--line);
    border-radius: 28px;
    background: var(--surface);
    box-shadow: var(--shadow);
    backdrop-filter: var(--glass);
    -webkit-backdrop-filter: var(--glass);
    animation: liquid-card-rise 560ms ease both;
  }

  .preview-panel {
    position: relative;
    display: grid;
    min-height: 420px;
    place-items: center;
    overflow: hidden;
    padding: 18px;
    isolation: isolate;
  }

  .preview-panel::before {
    position: absolute;
    inset: 0;
    pointer-events: none;
    background:
      linear-gradient(135deg, var(--panel-highlight), transparent 30%),
      linear-gradient(315deg, color-mix(in srgb, var(--accent-strong) 16%, transparent), transparent 44%);
    content: "";
  }

  .preview-panel::after {
    position: absolute;
    inset: auto -12% -30% auto;
    width: min(36vw, 360px);
    height: min(36vw, 360px);
    border-radius: 999px;
    background: radial-gradient(circle, color-mix(in srgb, var(--accent-strong) 24%, transparent), transparent 70%);
    content: "";
    pointer-events: none;
    animation: detail-glow-drift 9s ease-in-out infinite alternate;
  }

  .preview-panel img {
    position: relative;
    display: block;
    max-width: 100%;
    max-height: min(76vh, 820px);
    width: auto;
    height: auto;
    border-radius: 20px;
    object-fit: contain;
    background: var(--surface-soft);
    box-shadow: var(--soft-shadow);
    animation: preview-float 8s ease-in-out infinite;
  }

  .info-panel {
    padding: clamp(22px, 4vw, 34px);
    animation-delay: 80ms;
  }

  .eyebrow {
    margin: 0 0 10px;
    color: var(--accent);
    font-size: 0.78rem;
    font-weight: 900;
    letter-spacing: 0.08em;
    text-transform: uppercase;
  }

  h1,
  h2,
  p {
    margin-top: 0;
  }

  h1 {
    margin-bottom: 20px;
    overflow-wrap: anywhere;
    font-size: clamp(2rem, 4vw, 4rem);
    line-height: 1.05;
    letter-spacing: 0;
  }

  h2 {
    margin-bottom: 0;
    font-size: clamp(1.5rem, 3vw, 2.25rem);
    letter-spacing: 0;
  }

  .action-row {
    display: flex;
    flex-wrap: wrap;
    gap: 10px;
    margin-bottom: 14px;
  }

  .primary-action,
  .secondary-action {
    display: inline-flex;
    align-items: center;
    justify-content: center;
    min-height: 44px;
    padding: 0 16px;
    font: inherit;
    cursor: pointer;
  }

  .primary-action {
    border-color: var(--text);
    background: linear-gradient(135deg, var(--accent-strong), var(--accent));
    color: #fff;
    box-shadow: var(--soft-shadow);
  }

  .secondary-action {
    background: rgba(255, 255, 255, 0.58);
    box-shadow: var(--soft-shadow);
  }

  .primary-action:hover,
  .secondary-action:hover,
  .tag-list a:hover,
  .variant-switch a:hover {
    border-color: color-mix(in srgb, var(--accent-strong) 42%, var(--line));
    transform: translateY(-2px) scale(1.025);
  }

  .variant-switch {
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    gap: 10px 14px;
    margin-bottom: 24px;
    color: var(--muted);
    font-weight: 800;
  }

  .variant-switch div {
    display: inline-flex;
    overflow: hidden;
    border: 1px solid var(--line);
    border-radius: 16px;
    background: rgba(255, 255, 255, 0.58);
    box-shadow: var(--soft-shadow);
  }

  .variant-switch a,
  .variant-switch strong {
    padding: 8px 12px;
    color: inherit;
    text-decoration: none;
  }

  .variant-switch strong {
    background: linear-gradient(135deg, var(--accent-strong), var(--accent));
    color: #fff;
  }

  .metadata-list {
    display: grid;
    grid-template-columns: 112px minmax(0, 1fr);
    gap: 1px;
    overflow: hidden;
    border: 1px solid var(--line);
    border-radius: 18px;
    background: var(--line);
  }

  .metadata-list dt,
  .metadata-list dd {
    margin: 0;
    padding: 12px;
    background: rgba(255, 255, 255, 0.58);
  }

  .metadata-list dt {
    color: var(--muted);
    font-weight: 800;
  }

  .metadata-list dd {
    overflow-wrap: anywhere;
  }

  .metadata-link {
    color: var(--accent-strong);
    font-weight: 800;
  }

  .tag-list {
    display: flex;
    flex-wrap: wrap;
    gap: 8px;
    margin-top: 20px;
  }

  .tag-list a {
    padding: 8px 10px;
    background: rgba(255, 255, 255, 0.58);
    color: var(--muted);
    font-size: 0.88rem;
    box-shadow: var(--soft-shadow);
  }

  .related-section {
    margin-top: 20px;
    padding: clamp(22px, 4vw, 34px);
    animation-delay: 140ms;
  }

  .section-heading {
    margin-bottom: 20px;
  }

  .related-grid {
    display: grid;
    grid-template-columns: repeat(4, minmax(0, 1fr));
    gap: 14px;
  }

  .related-card {
    position: relative;
    overflow: hidden;
    border: 1px solid var(--line);
    border-radius: 22px;
    background: var(--surface);
    color: inherit;
    text-decoration: none;
    box-shadow: var(--soft-shadow);
    transition:
      transform 180ms cubic-bezier(0.2, 0.8, 0.2, 1),
      box-shadow 180ms ease,
      border-color 180ms ease;
    isolation: isolate;
  }

  .related-card::after {
    position: absolute;
    inset: 0;
    z-index: 1;
    border-radius: inherit;
    background: linear-gradient(115deg, transparent 24%, rgba(255, 255, 255, 0.38), transparent 58%);
    opacity: 0;
    transform: translateX(-34%);
    transition: opacity 180ms ease, transform 480ms ease;
    content: "";
    pointer-events: none;
  }

  .related-card:hover::after {
    opacity: 1;
    transform: translateX(34%);
  }

  .related-card:hover {
    border-color: color-mix(in srgb, var(--accent-strong) 42%, var(--line));
    box-shadow: 0 22px 46px rgba(45, 79, 118, 0.18);
    transform: translateY(-5px) scale(1.018);
  }

  .related-card:hover img {
    transform: scale(1.045);
  }

  .related-card img {
    display: block;
    width: 100%;
    aspect-ratio: 4 / 3;
    object-fit: cover;
    background: var(--surface-soft);
    transition: transform 220ms cubic-bezier(0.2, 0.8, 0.2, 1);
  }

  .related-card span,
  .related-card strong {
    display: block;
    overflow: hidden;
    padding-inline: 12px;
    text-overflow: ellipsis;
    white-space: nowrap;
  }

  .related-card span {
    padding-top: 12px;
    color: var(--muted);
    font-size: 0.82rem;
  }

  .related-card strong {
    padding-top: 4px;
    padding-bottom: 12px;
  }

  .empty-related {
    margin-bottom: 0;
    color: var(--muted);
  }

  @media (prefers-color-scheme: dark) {
    .top-nav a,
    .secondary-action,
    .variant-switch div,
    .metadata-list dt,
    .metadata-list dd,
    .tag-list a {
      background: rgba(21, 27, 35, 0.64);
    }

    .related-card::after {
      background: linear-gradient(115deg, transparent 24%, rgba(255, 255, 255, 0.1), transparent 58%);
    }
  }

  @keyframes preview-float {
    0%,
    100% {
      transform: translateY(0);
    }

    50% {
      transform: translateY(-4px);
    }
  }

  @keyframes detail-glow-drift {
    to {
      transform: translate3d(-24px, -18px, 0) scale(1.08);
    }
  }

  @media (prefers-reduced-motion: reduce) {
    .preview-panel::after,
    .preview-panel img {
      animation: none;
    }
  }

  @media (max-width: 980px) {
    .detail-hero {
      grid-template-columns: 1fr;
    }

    .preview-panel {
      min-height: 260px;
    }

    .related-grid {
      grid-template-columns: repeat(2, minmax(0, 1fr));
    }
  }

  @media (max-width: 620px) {
    .detail-shell {
      width: min(100% - 20px, 1320px);
      padding-top: 10px;
    }

    .preview-panel,
    .info-panel,
    .related-section {
      border-radius: 16px;
    }

    .action-row {
      display: grid;
    }

    .metadata-list {
      grid-template-columns: 1fr;
    }

    .metadata-list dt {
      padding-bottom: 4px;
    }

    .metadata-list dd {
      padding-top: 4px;
    }

    .related-grid {
      grid-template-columns: 1fr;
    }
  }
