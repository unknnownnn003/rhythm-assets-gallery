{
  "name": "rhythm-assets-gallery",
  "type": "module",
  "version": "0.0.1",
  "engines": {
    "node": ">=22.12.0"
  },
  "scripts": {
    "dev": "astro dev",
    "build": "astro build",
    "preview": "astro preview",
    "scan": "tsx scripts/scan-assets.ts",
    "thumbs": "tsx scripts/generate-thumbnails.ts",
    "sitemap": "tsx scripts/generate-sitemap.ts",
    "validate:assets": "tsx scripts/validate-assets.ts",
    "import:incoming": "tsx scripts/import-incoming-assets.ts",
    "arcaea:metadata": "tsx scripts/update-arcaea-metadata.ts",
    "arcaea:extract": "tsx scripts/extract-arcaea-update.ts",
    "arcaea:compress": "tsx scripts/compress-arcaea-update.ts",
    "arcaea:check-apk": "tsx scripts/check-arcaea-apk.ts",
    "arcaea:publish": "powershell -ExecutionPolicy Bypass -File scripts/publish-arcaea-update.ps1",
    "phigros:extract": "python scripts/extract-phigros-update.py",
    "phigros:publish": "powershell -ExecutionPolicy Bypass -File scripts/publish-phigros-update.ps1",
    "update": "npm run scan && npm run thumbs && npm run sitemap",
    "astro": "astro"
  },
  "dependencies": {
    "@astrojs/react": "^5.0.4",
    "astro": "^6.3.1",
    "fuse.js": "^7.3.0",
    "react": "^19.2.6",
    "react-dom": "^19.2.6"
  },
  "devDependencies": {
    "@tailwindcss/vite": "^4.2.4",
    "playwright": "^1.60.0",
    "sharp": "^0.34.5",
    "tailwindcss": "^4.2.4",
    "tsx": "^4.21.0"
  }
}
