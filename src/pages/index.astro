---
import fs from "node:fs";
import path from "node:path";

import "../styles/global.css";
import { homepageConfig } from "../lib/homepage-config";
import { SITE_NAME, SITE_URL, absoluteUrl, assetAlt, assetOgImage } from "../lib/seo";
import type { AssetItem, SiteSummary } from "../lib/types";

const dataDir = path.join(process.cwd(), "public", "data");
const homeStyle = [
  `--site-max-width: ${homepageConfig.theme.maxWidth}`,
  `--hero-min-height: ${homepageConfig.theme.heroMinHeight}`,
  `--hero-title-max: ${homepageConfig.theme.heroTitleMax}`,
  `--accent: ${homepageConfig.theme.accent}`,
  `--accent-strong: ${homepageConfig.theme.accentStrong}`,
  `--bili: ${homepageConfig.theme.bilibiliPink}`,
].join(";");

const summary = readJson<SiteSummary>("summary.json", {
  totalAssets: 0,
  games: [],
  generatedAt: new Date(0).toISOString(),
});
const recentUpdates = readJson<AssetItem[]>("recent-updates.json", []).slice(0, 8);
const heroPreviewAssets = recentUpdates.slice(0, 6);
const pageTitle = "Arcaea | Phigros 曲绘下载站 - Unknnownnn";
const pageDescription = "提供 Arcaea、Phigros 曲绘、曲包封面、角色立绘、头像、背景图等音游资源浏览、搜索与下载。";
const pageImage = recentUpdates[0] ? assetOgImage(recentUpdates[0]) : absoluteUrl("/site-icon.png");

const gameStats = new Map(summary.games.map((game) => [game.game, game]));
const arcaea = gameStats.get("Arcaea");
const phigros = gameStats.get("Phigros");
const arcaeaCategoryShortcuts = getGameCategoryShortcuts(summary, "Arcaea");
const phigrosCategoryShortcuts = getGameCategoryShortcuts(summary, "Phigros");
const totalCategoryCount = countUniqueCategories(summary);
const generatedAt = new Intl.DateTimeFormat("zh-CN", {
  year: "numeric",
  month: "2-digit",
  day: "2-digit",
  hour: "2-digit",
  minute: "2-digit",
}).format(new Date(summary.generatedAt));

function readJson<T>(filename: string, fallback: T): T {
  const filePath = path.join(dataDir, filename);
  if (!fs.existsSync(filePath)) {
    return fallback;
  }
  return JSON.parse(fs.readFileSync(filePath, "utf8")) as T;
}

function getGameCategoryShortcuts(siteSummary: SiteSummary, gameName: "Arcaea" | "Phigros") {
  const game = siteSummary.games.find((item) => item.game === gameName);
  if (!game) {
    return [];
  }

  const hrefBase = gameName === "Arcaea" ? "/arcaea" : "/phigros";
  return Object.entries(game.categories)
    .map(([name, count]) => ({ name, count, href: `${hrefBase}?category=${encodeURIComponent(name)}` }))
    .sort((a, b) => b.count - a.count || a.name.localeCompare(b.name, "zh-CN"))
    .slice(0, 8);
}

function countUniqueCategories(siteSummary: SiteSummary) {
  const categories = new Set<string>();
  for (const game of siteSummary.games) {
    if (game.game === "Unknown") {
      continue;
    }
    for (const category of Object.keys(game.categories)) {
      categories.add(category);
    }
  }
  return categories.size;
}

function formatBytes(bytes?: number) {
  if (!bytes) {
    return homepageConfig.sections.unknownSize;
  }
  if (bytes < 1024 * 1024) {
    return `${Math.round(bytes / 1024)} KB`;
  }
  return `${(bytes / 1024 / 1024).toFixed(1)} MB`;
}
---

<!doctype html>
<html lang="zh-CN">
  <head>
    <meta charset="utf-8" />
    <link rel="icon" type="image/png" href="/site-icon.png" />
    <link rel="apple-touch-icon" href="/apple-touch-icon.png" />
    <link rel="manifest" href="/site.webmanifest" />
    <link rel="canonical" href={SITE_URL + "/"} />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <meta name="generator" content={Astro.generator} />
    <meta name="description" content={pageDescription} />
    <meta property="og:type" content="website" />
    <meta property="og:site_name" content={SITE_NAME} />
    <meta property="og:title" content={pageTitle} />
    <meta property="og:description" content={pageDescription} />
    <meta property="og:url" content={SITE_URL + "/"} />
    <meta property="og:image" content={pageImage} />
    <title>{pageTitle}</title>
  </head>
  <body>
    <main class="site-shell" style={homeStyle}>
      <section class="hero">
        <div class="hero-copy">
          <p class="eyebrow">{homepageConfig.hero.eyebrow}</p>
          <h1>{homepageConfig.hero.title}</h1>
          <p class="hero-text">{homepageConfig.hero.description}</p>

          <form class="search-entry" action="/search" method="get">
            <label class="sr-only" for="home-search">{homepageConfig.hero.searchLabel}</label>
            <input id="home-search" name="q" type="search" placeholder={homepageConfig.hero.searchPlaceholder} />
            <button type="submit">{homepageConfig.hero.searchButton}</button>
          </form>

          {
            heroPreviewAssets.length > 0 ? (
              <div class="hero-preview-strip" aria-label="最近资源预览">
                {heroPreviewAssets.map((asset) => (
                  <a href={`/asset/${asset.id}`}>
                    <img
                      src={asset.thumbnailSmall ?? asset.thumbnailMedium}
                      alt={assetAlt(asset)}
                      width={asset.width ?? 240}
                      height={asset.height ?? 180}
                      loading="lazy"
                      decoding="async"
                    />
                    <span>{asset.game}</span>
                  </a>
                ))}
              </div>
            ) : null
          }
        </div>

        <aside class="hero-side" aria-label="站点信息">
          {
            homepageConfig.bilibili.enabled && (
              <div class="owner-card">
                <div class="owner-head">
                  <img
                    src={homepageConfig.bilibili.avatar}
                    alt={`${homepageConfig.bilibili.name} 的头像`}
                    width="56"
                    height="56"
                    loading="lazy"
                    decoding="async"
                  />
                  <div>
                    <span class="bili-mark">{homepageConfig.bilibili.badge}</span>
                    <strong>{homepageConfig.bilibili.name}</strong>
                  </div>
                </div>
                <p>{homepageConfig.bilibili.description}</p>
                <a href={homepageConfig.bilibili.url} target="_blank" rel="noopener noreferrer">
                  {homepageConfig.bilibili.button}
                </a>
              </div>
            )
          }

          <div class="quick-stats" aria-label="资源统计">
            <a href="/search">
              <span class="stat-value">{summary.totalAssets.toLocaleString("zh-CN")}</span>
              <span class="stat-label">{homepageConfig.stats.totalAssetsLabel}</span>
            </a>
            <a href="#categories">
              <span class="stat-value">{totalCategoryCount}</span>
              <span class="stat-label">{homepageConfig.stats.categoryShortcutLabel}</span>
            </a>
          </div>
        </aside>
      </section>

      <section class="game-grid" aria-label="游戏入口">
        <a class="game-card arcaea-card" href="/arcaea">
          <span class="card-kicker">Arcaea</span>
          <strong>{arcaea?.totalAssets.toLocaleString("zh-CN") ?? 0} 张</strong>
          <span>{Object.keys(arcaea?.categories ?? {}).length} {homepageConfig.games.arcaeaDescription}</span>
          <em>{homepageConfig.games.entryCta}</em>
        </a>

        <a class="game-card phigros-card" href="/phigros">
          <span class="card-kicker">Phigros</span>
          <strong>{phigros?.totalAssets.toLocaleString("zh-CN") ?? 0} 张</strong>
          <span>{Object.keys(phigros?.categories ?? {}).length} {homepageConfig.games.phigrosDescription}</span>
          <em>{homepageConfig.games.entryCta}</em>
        </a>
      </section>

      <section id="categories" class="section-block category-section">
        <div class="section-heading">
          <p class="eyebrow">{homepageConfig.sections.categoriesEyebrow}</p>
          <h2>{homepageConfig.sections.categoriesTitle}</h2>
        </div>
        <div class="category-columns">
          <div class="category-group">
            <div class="category-group-head">
              <strong>Arcaea</strong>
              <a href="/arcaea">进入 Arcaea 浏览</a>
            </div>
            <div class="category-list">
              {
                arcaeaCategoryShortcuts.map((category) => (
                  <a href={category.href} class="category-chip">
                    <span>{category.name}</span>
                    <strong>{category.count}</strong>
                  </a>
                ))
              }
            </div>
          </div>
          <div class="category-group">
            <div class="category-group-head">
              <strong>Phigros</strong>
              <a href="/phigros">进入 Phigros 浏览</a>
            </div>
            <div class="category-list">
              {
                phigrosCategoryShortcuts.map((category) => (
                  <a href={category.href} class="category-chip">
                    <span>{category.name}</span>
                    <strong>{category.count}</strong>
                  </a>
                ))
              }
            </div>
          </div>
        </div>
      </section>

      <section class="section-block">
        <div class="section-heading split-heading">
          <div>
            <p class="eyebrow">{homepageConfig.sections.recentEyebrow}</p>
            <h2>{homepageConfig.sections.recentTitle}</h2>
          </div>
          <span class="muted">{homepageConfig.sections.generatedPrefix}{generatedAt}</span>
        </div>

        <div class="recent-grid">
          {
            recentUpdates.map((asset) => (
              <a class="asset-card" href={`/asset/${asset.id}`}>
                <img
                  src={asset.thumbnailSmall ?? asset.thumbnailMedium}
                  alt={assetAlt(asset)}
                  loading="lazy"
                  decoding="async"
                  width={asset.width ?? 320}
                  height={asset.height ?? 240}
                />
                <span class="asset-meta">{asset.game} / {asset.category}</span>
                <strong>{asset.title}</strong>
                <span>{formatBytes(asset.sizeBytes)}</span>
              </a>
            ))
          }
        </div>
      </section>

      <section class="section-block stats-band">
        <div>
          <p class="eyebrow">{homepageConfig.sections.overviewEyebrow}</p>
          <h2>{homepageConfig.sections.overviewTitle}</h2>
        </div>
        <div class="stats-grid">
          {
            summary.games
              .filter((game) => game.game !== "Unknown" || game.totalAssets > 0)
              .map((game) => (
                <a class="mini-stat" href={game.game === "Arcaea" ? "/arcaea" : game.game === "Phigros" ? "/phigros" : "/search"}>
                  <span>{game.game}</span>
                  <strong>{game.totalAssets.toLocaleString("zh-CN")}</strong>
                  <small>{Object.keys(game.categories).length} {homepageConfig.sections.categoryUnit}</small>
                </a>
              ))
          }
        </div>
      </section>

      <section class="section-block seo-intro">
        <p>
          Arcaea 与 Phigros 曲绘下载站收集并整理相关图片资源，包括曲绘、曲包封面、角色立绘、头像、剧情 CG、启动页面和游玩背景等。本站支持按游戏、分类、曲包、BPM、版本等信息搜索和筛选，方便玩家快速找到需要的音游资源。
        </p>
      </section>

      <footer class="site-footer">
        <span>{homepageConfig.footer.copyright}</span>
        <span>{homepageConfig.footer.assetNote}</span>
        <span>{homepageConfig.footer.contact}</span>
        <a href="https://github.com/unknnownnn003/rhythm-assets-gallery" target="_blank" rel="noopener noreferrer">GitHub</a>
      </footer>
    </main>
  </body>
</html>

<style>
  :global(:root) {
    color-scheme: light dark;
    --bg: #f7fbff;
    --surface: rgba(255, 255, 255, 0.74);
    --surface-solid: #ffffff;
    --surface-soft: rgba(239, 246, 255, 0.72);
    --text: #102033;
    --muted: #627084;
    --line: rgba(136, 158, 182, 0.28);
    --accent: #0f8f8a;
    --accent-strong: #2563eb;
    --warm: #ffb454;
    --rose: #fb7299;
    --blue: #61a5ff;
    --bili: #fb7299;
    --glass: blur(22px) saturate(1.45);
    --shadow: 0 18px 44px rgba(45, 79, 118, 0.16);
    --soft-shadow: 0 10px 26px rgba(45, 79, 118, 0.12);
  }

  :global(body) {
    background:
      linear-gradient(120deg, rgba(97, 165, 255, 0.18), transparent 28rem),
      linear-gradient(240deg, rgba(255, 180, 84, 0.16), transparent 30rem),
      linear-gradient(180deg, var(--bg), #ffffff 44rem);
    color: var(--text);
  }

  .site-shell {
    width: min(var(--site-max-width), calc(100% - 32px));
    margin: 0 auto;
    padding: 30px 0 56px;
  }

  .hero {
    display: grid;
    grid-template-columns: minmax(0, 1.25fr) minmax(280px, 0.75fr);
    gap: 20px;
    align-items: stretch;
    perspective: 1200px;
  }

  .hero-copy,
  .owner-card,
  .quick-stats,
  .game-card,
  .section-block,
  .asset-card {
    border: 1px solid var(--line);
    background: var(--surface);
    backdrop-filter: var(--glass);
    -webkit-backdrop-filter: var(--glass);
    box-shadow: var(--shadow);
  }

  .hero-copy {
    position: relative;
    display: flex;
    min-height: var(--hero-min-height);
    flex-direction: column;
    justify-content: center;
    overflow: hidden;
    border-radius: 30px;
    padding: clamp(26px, 5vw, 56px);
  }

  .hero-copy::before {
    position: absolute;
    inset: 0;
    pointer-events: none;
    background:
      linear-gradient(135deg, rgba(255, 255, 255, 0.74), transparent 34%),
      linear-gradient(315deg, rgba(97, 165, 255, 0.18), transparent 42%);
    content: "";
  }

  .hero-copy > * {
    position: relative;
  }

  .eyebrow {
    margin: 0 0 10px;
    color: var(--accent);
    font-size: 0.78rem;
    font-weight: 900;
    letter-spacing: 0.08em;
    text-transform: uppercase;
  }

  h1,
  h2,
  p {
    margin-top: 0;
  }

  h1 {
    max-width: 680px;
    margin-bottom: 16px;
    font-size: clamp(2.55rem, 5.2vw, var(--hero-title-max));
    line-height: 1.02;
    letter-spacing: 0;
  }

  h2 {
    margin-bottom: 0;
    font-size: clamp(1.35rem, 2.4vw, 2rem);
    line-height: 1.15;
    letter-spacing: 0;
  }

  .hero-text {
    max-width: 680px;
    margin-bottom: 26px;
    color: var(--muted);
    font-size: 1rem;
    line-height: 1.8;
  }

  .search-entry {
    display: flex;
    width: min(640px, 100%);
    gap: 10px;
    padding: 8px;
    border: 1px solid var(--line);
    border-radius: 22px;
    background: rgba(255, 255, 255, 0.72);
    box-shadow: inset 0 1px 0 rgba(255, 255, 255, 0.8);
    backdrop-filter: blur(18px);
    -webkit-backdrop-filter: blur(18px);
  }

  .search-entry input {
    min-width: 0;
    flex: 1;
    border: 0;
    padding: 0 18px;
    background: transparent;
    color: var(--text);
    font: inherit;
    outline: none;
  }

  .search-entry button {
    min-height: 46px;
    border: 0;
    border-radius: 16px;
    padding: 12px 22px;
    background: linear-gradient(135deg, var(--accent-strong), var(--accent));
    color: #fff;
    font: inherit;
    font-weight: 800;
    cursor: pointer;
    box-shadow: var(--soft-shadow);
    transition: transform 160ms ease, box-shadow 160ms ease;
  }

  .search-entry button:hover {
    transform: translateY(-2px) scale(1.02);
    box-shadow: 0 14px 30px rgba(37, 99, 235, 0.2);
  }

  .hero-preview-strip {
    display: grid;
    grid-template-columns: repeat(6, minmax(0, 1fr));
    width: min(640px, 100%);
    gap: 12px;
    margin-top: 22px;
  }

  .hero-preview-strip a {
    position: relative;
    display: block;
    width: 100%;
    overflow: hidden;
    border: 1px solid rgba(255, 255, 255, 0.72);
    border-radius: 22px;
    background: var(--surface-soft);
    box-shadow: var(--soft-shadow);
    color: inherit;
    text-decoration: none;
    transform: rotate(var(--tilt, -2deg));
    transition: transform 180ms ease, box-shadow 180ms ease;
  }

  .hero-preview-strip a:nth-child(2) {
    --tilt: 2deg;
  }

  .hero-preview-strip a:nth-child(3) {
    --tilt: -1deg;
  }

  .hero-preview-strip a:nth-child(4) {
    --tilt: 1.5deg;
  }

  .hero-preview-strip a:nth-child(5) {
    --tilt: -2.5deg;
  }

  .hero-preview-strip a:nth-child(6) {
    --tilt: 2.5deg;
  }

  .hero-preview-strip a:hover {
    transform: translateY(-4px) rotate(0deg) scale(1.04);
    box-shadow: 0 16px 32px rgba(45, 79, 118, 0.18);
  }

  .hero-preview-strip img {
    display: block;
    width: 100%;
    aspect-ratio: 1;
    object-fit: cover;
  }

  .hero-preview-strip span {
    position: absolute;
    right: 7px;
    bottom: 7px;
    border-radius: 999px;
    padding: 4px 7px;
    background: rgba(255, 255, 255, 0.72);
    color: var(--text);
    font-size: 0.7rem;
    font-weight: 900;
    backdrop-filter: blur(12px);
  }

  .hero-side {
    display: grid;
    grid-template-rows: auto auto;
    gap: 20px;
  }

  .owner-card {
    display: flex;
    min-height: 184px;
    flex-direction: column;
    justify-content: space-between;
    border-radius: 28px;
    padding: 22px;
    background:
      radial-gradient(circle at 12% 16%, rgba(251, 114, 153, 0.28), transparent 28%),
      linear-gradient(135deg, rgba(251, 114, 153, 0.18), rgba(255, 255, 255, 0.66) 52%),
      var(--surface);
    transition: transform 180ms ease, box-shadow 180ms ease;
  }

  .owner-card:hover {
    transform: translateY(-3px);
    box-shadow: 0 24px 50px rgba(251, 114, 153, 0.18);
  }

  .owner-head {
    display: flex;
    gap: 12px;
    align-items: center;
  }

  .owner-head img {
    display: block;
    width: 56px;
    height: 56px;
    flex: 0 0 auto;
    border: 3px solid rgba(255, 255, 255, 0.78);
    border-radius: 22px;
    object-fit: cover;
    box-shadow: 0 12px 28px rgba(251, 114, 153, 0.18);
  }

  .bili-mark {
    display: inline-flex;
    width: max-content;
    margin-bottom: 8px;
    border-radius: 999px;
    padding: 7px 11px;
    background: color-mix(in srgb, var(--bili) 16%, var(--surface));
    color: var(--bili);
    font-size: 0.82rem;
    font-weight: 900;
  }

  .owner-card strong,
  .owner-card p {
    display: block;
  }

  .owner-card strong {
    margin-bottom: 0;
    font-size: 1.28rem;
    line-height: 1.18;
  }

  .owner-card p {
    margin: 18px 0 0;
    color: var(--muted);
    line-height: 1.7;
  }

  .owner-card a {
    width: max-content;
    margin-top: 14px;
    border-radius: 16px;
    padding: 11px 16px;
    background: linear-gradient(135deg, var(--bili), #ff9fb7);
    color: #fff;
    font-weight: 900;
    text-decoration: none;
    box-shadow: 0 12px 26px rgba(251, 114, 153, 0.24);
    transition: transform 160ms ease, box-shadow 160ms ease;
  }

  .owner-card a:hover {
    transform: translateY(-2px);
    box-shadow: 0 16px 34px rgba(251, 114, 153, 0.32);
  }

  .quick-stats {
    display: grid;
    grid-template-columns: repeat(2, minmax(0, 1fr));
    overflow: hidden;
    border-radius: 28px;
    background: var(--line);
    gap: 1px;
  }

  .quick-stats > a {
    display: flex;
    min-height: 124px;
    flex-direction: column;
    justify-content: center;
    padding: 22px;
    background: rgba(255, 255, 255, 0.66);
    color: inherit;
    text-decoration: none;
    transition: background 160ms ease, transform 160ms ease;
  }

  .quick-stats > a:hover {
    background: rgba(255, 255, 255, 0.86);
    transform: translateY(-2px);
  }

  .stat-value {
    font-size: clamp(1.8rem, 4vw, 3rem);
    font-weight: 900;
    line-height: 1;
  }

  .stat-label,
  .muted,
  .asset-card span,
  .game-card span,
  .mini-stat small {
    color: var(--muted);
  }

  .game-grid {
    display: grid;
    grid-template-columns: repeat(2, minmax(0, 1fr));
    gap: 20px;
    margin-top: 20px;
  }

  .game-card {
    position: relative;
    display: flex;
    min-height: 170px;
    flex-direction: column;
    justify-content: flex-end;
    border-radius: 28px;
    padding: 26px;
    color: inherit;
    text-decoration: none;
    transition: transform 180ms ease, box-shadow 180ms ease, border-color 180ms ease;
  }

  .game-card:hover,
  .asset-card:hover,
  .category-chip:hover {
    border-color: color-mix(in srgb, var(--accent-strong) 38%, var(--line));
    box-shadow: 0 22px 46px rgba(45, 79, 118, 0.18);
    transform: translateY(-4px) scale(1.01);
  }

  .game-card strong {
    margin-bottom: 8px;
    font-size: clamp(1.55rem, 2.6vw, 2.15rem);
    line-height: 1.1;
  }

  .game-card em {
    width: max-content;
    margin-top: 18px;
    border-radius: 999px;
    padding: 9px 13px;
    background: rgba(255, 255, 255, 0.62);
    color: var(--accent-strong);
    font-style: normal;
    font-weight: 900;
    transition: transform 160ms ease, background 160ms ease;
  }

  .game-card:hover em {
    background: rgba(255, 255, 255, 0.84);
    transform: translateX(4px);
  }

  .card-kicker {
    margin-bottom: auto;
    font-weight: 900;
  }

  .arcaea-card {
    background:
      linear-gradient(135deg, rgba(103, 232, 249, 0.2), rgba(255, 255, 255, 0.7)),
      var(--surface);
  }

  .phigros-card {
    background:
      linear-gradient(135deg, rgba(253, 164, 175, 0.22), rgba(255, 246, 214, 0.68)),
      var(--surface);
  }

  .section-block {
    margin-top: 20px;
    border-radius: 28px;
    padding: clamp(22px, 4vw, 34px);
  }

  .section-heading {
    margin-bottom: 22px;
  }

  .split-heading {
    display: flex;
    gap: 16px;
    align-items: end;
    justify-content: space-between;
  }

  .category-list {
    display: flex;
    flex-wrap: wrap;
    gap: 10px;
  }

  .category-columns {
    display: grid;
    grid-template-columns: repeat(2, minmax(0, 1fr));
    gap: 18px;
  }

  .category-group {
    border: 1px solid var(--line);
    border-radius: 22px;
    padding: 18px;
    background: rgba(255, 255, 255, 0.42);
