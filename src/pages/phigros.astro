---
import fs from "node:fs";
import path from "node:path";

import GalleryGrid from "../components/GalleryGrid";
import "../styles/global.css";
import { SITE_NAME, absoluteUrl, assetOgImage } from "../lib/seo";
import type { AssetItem } from "../lib/types";

const assets = readAssets("phigros-index.json");
const pageTitle = "Phigros 曲绘资源下载 - Unknnownnn";
const pageDescription = "浏览和搜索 Phigros 曲绘、头像、曲包封面、April Fools 等图片资源。";
const pageUrl = absoluteUrl("/phigros/");
const pageImage = assets[0] ? assetOgImage(assets[0]) : absoluteUrl("/site-icon.png");

function readAssets(filename: string): AssetItem[] {
  const filePath = path.join(process.cwd(), "public", "data", filename);
  if (!fs.existsSync(filePath)) {
    return [];
  }
  return JSON.parse(fs.readFileSync(filePath, "utf8")) as AssetItem[];
}
---

<!doctype html>
<html lang="zh-CN">
  <head>
    <meta charset="utf-8" />
    <link rel="icon" type="image/png" href="/site-icon.png" />
    <link rel="apple-touch-icon" href="/apple-touch-icon.png" />
    <link rel="manifest" href="/site.webmanifest" />
    <link rel="canonical" href={pageUrl} />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <meta name="generator" content={Astro.generator} />
    <meta name="description" content={pageDescription} />
    <meta property="og:type" content="website" />
    <meta property="og:site_name" content={SITE_NAME} />
    <meta property="og:title" content={pageTitle} />
    <meta property="og:description" content={pageDescription} />
    <meta property="og:url" content={pageUrl} />
    <meta property="og:image" content={pageImage} />
    <title>{pageTitle}</title>
  </head>
  <body class="theme-phigros">
    <main class="gallery-page-shell">
      <header class="gallery-page-hero">
        <nav>
          <a href="/">首页</a>
          <a href="/arcaea">Arcaea</a>
        </nav>
        <p class="eyebrow">Phigros Gallery</p>
        <h1>Phigros 资源图库</h1>
        <p>当前索引 {assets.length.toLocaleString("zh-CN")} 个资源。搜索和筛选仅加载 Phigros 索引。</p>
        <p class="seo-copy">本页整理 Phigros 曲绘、头像、曲包封面、April Fools 等图片资源。你可以通过曲名、分类、文件名或版本信息快速搜索和筛选。</p>
      </header>

      <GalleryGrid assets={assets} game="Phigros" client:load />
    </main>
  </body>
</html>
