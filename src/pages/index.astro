---
import fs from "node:fs";
import path from "node:path";

import SiteNav from "../components/SiteNav.astro";
import VisitorStats from "../components/VisitorStats";
import "../styles/global.css";
import { homepageConfig } from "../lib/homepage-config";
import { SITE_NAME, SITE_URL, absoluteUrl, assetAlt, assetOgImage } from "../lib/seo";
import type { AssetItem, SiteSummary } from "../lib/types";

const dataDir = path.join(process.cwd(), "public", "data");

const summary = readJson<SiteSummary>("summary.json", {
  totalAssets: 0,
  games: [],
  generatedAt: new Date(0).toISOString(),
});
const allRecentUpdates = readJson<AssetItem[]>("recent-updates.json", []);
const recentUpdates = allRecentUpdates.slice(0, 6);
const gameStats = new Map(summary.games.map((game) => [game.game, game]));
const arcaea = gameStats.get("Arcaea");
const phigros = gameStats.get("Phigros");
const arcaeaCategoryShortcuts = getGameCategoryShortcuts(summary, "Arcaea");
const phigrosCategoryShortcuts = getGameCategoryShortcuts(summary, "Phigros");
const featuredCategoryCards = buildFeaturedCategoryCards(summary);
const totalCategoryCount = countUniqueCategories(summary);
const generatedAt = new Intl.DateTimeFormat("zh-CN", {
  year: "numeric",
  month: "2-digit",
  day: "2-digit",
  hour: "2-digit",
  minute: "2-digit",
}).format(new Date(summary.generatedAt));

const pageTitle = `${homepageConfig.siteTitle} - Unknnownnn`;
const pageDescription = homepageConfig.metaDescription;
const pageImage = recentUpdates[0] ? assetOgImage(recentUpdates[0]) : absoluteUrl("/site-icon.png");
const navLinks = [
  { href: "/", label: "首页" },
  { href: "/arcaea", label: "Arcaea" },
  { href: "/phigros", label: "Phigros" },
  { href: "/search", label: "搜索" },
];
const apkMeta = readJson<{ latest?: { version: string; filename: string; sizeBytes: number } | null; history: Array<{ version: string; scrapedAt: string; sizeBytes: number }> }>("arcaea-apk.json", { history: [] });
const hasApk = apkMeta.latest && apkMeta.history.length > 0;
const apkDownload = hasApk
  ? {
      title: "Arcaea 客户端",
      status: "可用",
      version: apkMeta.latest!.version,
      updatedAt: new Intl.DateTimeFormat("zh-CN", {
        year: "numeric",
        month: "2-digit",
        day: "2-digit",
      }).format(new Date(apkMeta.history[0].scrapedAt)),
      downloadCount: apkMeta.history.length > 1 ? `累计 ${apkMeta.history.length} 个版本` : "最新版本",
      href: `/downloads/arcaea/${apkMeta.latest!.filename}`,
      button: `下载 ${apkMeta.latest!.version}`,
      note: `文件大小 ${(apkMeta.latest!.sizeBytes / 1024 / 1024).toFixed(1)} MB，服务器保留最近 ${Math.min(apkMeta.history.length, 3)} 个版本。`,
    }
  : null;

const announcementItems = [
  `最近数据更新时间：${generatedAt}`,
  ...homepageConfig.announcements,
];

function readJson<T>(filename: string, fallback: T): T {
  const filePath = path.join(dataDir, filename);
  if (!fs.existsSync(filePath)) {
    return fallback;
  }
  return JSON.parse(fs.readFileSync(filePath, "utf8")) as T;
}

function getGameCategoryShortcuts(siteSummary: SiteSummary, gameName: "Arcaea" | "Phigros") {
  const game = siteSummary.games.find((item) => item.game === gameName);
  if (!game) {
    return [];
  }

  const hrefBase = gameName === "Arcaea" ? "/arcaea" : "/phigros";
  return Object.entries(game.categories)
    .map(([name, count]) => ({ name, count, href: `${hrefBase}?category=${encodeURIComponent(name)}` }))
    .sort((a, b) => b.count - a.count || a.name.localeCompare(b.name, "zh-CN"))
    .slice(0, 8);
}

function countUniqueCategories(siteSummary: SiteSummary) {
  const categories = new Set<string>();
  for (const game of siteSummary.games) {
    if (game.game === "Unknown") {
      continue;
    }
    for (const category of Object.keys(game.categories)) {
      categories.add(category);
    }
  }
  return categories.size;
}

type FeaturedCategoryCard = {
  label: string;
  count: number;
  href: string;
  hint: string;
  accent: string;
};

function buildFeaturedCategoryCards(siteSummary: SiteSummary) {
  const accents = ["sea", "sky", "ember", "gold", "mint", "ink"];
  const cards: FeaturedCategoryCard[] = [];

  for (const gameName of ["Arcaea", "Phigros"] as const) {
    const game = siteSummary.games.find((item) => item.game === gameName);
    if (!game) {
      continue;
    }

    const topCategories = Object.entries(game.categories)
      .map(([name, count]) => ({ name, count }))
      .sort((a, b) => b.count - a.count || a.name.localeCompare(b.name, "zh-CN"))
      .slice(0, 3);

    for (const category of topCategories) {
      cards.push({
        label: category.name,
        count: category.count,
        href: `${gameName === "Arcaea" ? "/arcaea" : "/phigros"}?category=${encodeURIComponent(category.name)}`,
        hint: gameName,
        accent: accents[cards.length % accents.length],
      });
    }
  }

  return cards.slice(0, 6);
}

function formatBytes(bytes?: number) {
  if (!bytes) {
    return "未知大小";
  }
  if (bytes < 1024 * 1024) {
    return `${Math.round(bytes / 1024)} KB`;
  }
  return `${(bytes / 1024 / 1024).toFixed(1)} MB`;
}
---

<!doctype html>
<html lang="zh-CN">
  <head>
    <meta charset="utf-8" />
    <link rel="icon" type="image/png" href="/site-icon.png" />
    <link rel="apple-touch-icon" href="/apple-touch-icon.png" />
    <link rel="manifest" href="/site.webmanifest" />
    <link rel="canonical" href={SITE_URL + "/"} />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <meta name="generator" content={Astro.generator} />
    <meta name="description" content={pageDescription} />
    <meta property="og:type" content="website" />
    <meta property="og:site_name" content={SITE_NAME} />
    <meta property="og:title" content={pageTitle} />
    <meta property="og:description" content={pageDescription} />
    <meta property="og:url" content={SITE_URL + "/"} />
    <meta property="og:image" content={pageImage} />
    <title>{pageTitle}</title>
  </head>
  <body>
    <SiteNav links={navLinks} />

    <main class="home-shell">
      <section class="home-hero" data-reveal>
        <div class="home-hero-copy">
          <p class="eyebrow">{homepageConfig.hero.eyebrow}</p>
          <h1>{homepageConfig.hero.title}</h1>
          <p class="hero-description">{homepageConfig.hero.description}</p>

          <form class="hero-search" action="/search" method="get">
            <label class="sr-only" for="home-search-input">{homepageConfig.hero.searchLabel}</label>
            <input
              id="home-search-input"
              name="q"
              type="search"
              placeholder={homepageConfig.hero.searchPlaceholder}
              autoComplete="off"
            />
            <button type="submit">{homepageConfig.hero.searchButton}</button>
          </form>

          <div class="hero-chip-row" aria-label="快捷入口">
            {
              homepageConfig.hero.chips.map((chip) => (
                <a class="hero-chip" href={chip.href}>
                  {chip.label}
                </a>
              ))
            }
          </div>

          <div class="hero-download-card">
            <div class="hero-download-head">
              <span class={`hero-download-badge${hasApk ? " is-ready" : ""}`}>
                {apkDownload?.status ?? homepageConfig.clientDownload.status}
              </span>
              <strong>{apkDownload?.title ?? homepageConfig.clientDownload.title}</strong>
            </div>
            <div class="hero-download-stats">
              <div>
                <small>版本</small>
                <span>{apkDownload?.version ?? homepageConfig.clientDownload.version}</span>
              </div>
              <div>
                <small>更新日期</small>
                <span>{apkDownload?.updatedAt ?? homepageConfig.clientDownload.updatedAt}</span>
              </div>
              <div>
                <small>下载次数</small>
                <span>{apkDownload?.downloadCount ?? homepageConfig.clientDownload.downloadCount}</span>
              </div>
            </div>
            {
              (apkDownload?.href ?? homepageConfig.clientDownload.href) ? (
                <a class="hero-download-btn" href={apkDownload?.href ?? homepageConfig.clientDownload.href}>
                  {apkDownload?.button ?? homepageConfig.clientDownload.button}
                </a>
              ) : (
                <span class="hero-download-btn is-pending">
                  {homepageConfig.clientDownload.button}
                </span>
              )
            }
          </div>
        </div>
      </section>

      <div class="home-content">
      <section class="home-stat-strip" data-reveal>
        <a class="home-stat-card is-primary" href="/search">
          <span>全站资源</span>
          <strong>{summary.totalAssets.toLocaleString("zh-CN")}</strong>
          <small>{totalCategoryCount} 个有效分类</small>
        </a>
        <a class="home-stat-card" href="/arcaea">
          <span>Arcaea</span>
          <strong>{arcaea?.totalAssets.toLocaleString("zh-CN") ?? 0}</strong>
          <small>{Object.keys(arcaea?.categories ?? {}).length} 个分类</small>
        </a>
        <a class="home-stat-card" href="/phigros">
          <span>Phigros</span>
          <strong>{phigros?.totalAssets.toLocaleString("zh-CN") ?? 0}</strong>
          <small>{Object.keys(phigros?.categories ?? {}).length} 个分类</small>
        </a>
      </section>

      <div class="home-layout">
        <section class="home-primary">
          <section class="home-section" data-reveal>
            <div class="section-head">
              <div>
                <p class="eyebrow">Recent Updates</p>
                <h2>最近更新曲绘</h2>
              </div>
              <span>最新索引同步于 {generatedAt}</span>
            </div>

            <div class="home-update-grid">
              {
                recentUpdates.map((asset) => (
                  <article class="update-card glass-panel">
                    <a class="update-card-media" href={`/asset/${asset.id}`}>
                      <img
                        src={asset.thumbnailSmall ?? asset.thumbnailMedium}
                        alt={assetAlt(asset)}
                        loading="lazy"
                        decoding="async"
                        width={asset.width ?? 320}
                        height={asset.height ?? 240}
                      />
                    </a>
                    <div class="update-card-body">
                      <p>{asset.game} / {asset.category}</p>
                      <h3>{asset.title}</h3>
                      <span>{asset.artist ?? asset.packDisplayName ?? asset.pack ?? asset.filename}</span>
                      <div class="update-card-actions">
                        <a href={`/asset/${asset.id}`}>查看详情</a>
                        <a href={asset.url} download={asset.filename}>下载原图</a>
                      </div>
                      <small>{formatBytes(asset.sizeBytes)}</small>
                    </div>
                  </article>
                ))
              }
            </div>
          </section>

          <section class="home-section" data-reveal>
            <div class="section-head">
              <div>
                <p class="eyebrow">Category Shortcuts</p>
                <h2>常用分类与快速跳转</h2>
              </div>
            </div>

            <div class="featured-category-grid">
              {
                featuredCategoryCards.map((card) => (
                  <a class={`featured-category is-${card.accent}`} href={card.href}>
                    <span>{card.hint}</span>
                    <strong>{card.label}</strong>
                    <small>{card.count} 张</small>
                  </a>
                ))
              }
            </div>

            <div class="shortcut-columns">
              <section class="shortcut-column">
                <div class="shortcut-column-head">
                  <strong>Arcaea</strong>
                  <a href="/arcaea">进入 Arcaea</a>
                </div>
                <div class="shortcut-link-list">
                  {
                    arcaeaCategoryShortcuts.map((item) => (
                      <a href={item.href}>
                        <span>{item.name}</span>
                        <strong>{item.count}</strong>
                      </a>
                    ))
                  }
                </div>
              </section>

              <section class="shortcut-column">
                <div class="shortcut-column-head">
                  <strong>Phigros</strong>
                  <a href="/phigros">进入 Phigros</a>
                </div>
                <div class="shortcut-link-list">
                  {
                    phigrosCategoryShortcuts.map((item) => (
                      <a href={item.href}>
                        <span>{item.name}</span>
                        <strong>{item.count}</strong>
                      </a>
                    ))
                  }
                </div>
              </section>
            </div>
          </section>

          <section class="home-section home-seo-note" data-reveal>
            <p>
              本站继续使用现有的静态 JSON 索引与图片目录结构，面向 Arcaea 与 Phigros
              的曲绘、角色立绘、曲包封面、剧情 CG、启动页面和游玩背景等资源提供更高效的浏览、筛选与下载入口。
            </p>
          </section>
        </section>

        <aside class="home-sidebar">
          <VisitorStats client:load />

          {
            homepageConfig.bilibili.enabled ? (
              <section class="side-card glass-panel" data-reveal>
                <div class="side-card-head">
                  <span>{homepageConfig.bilibili.badge}</span>
                  <strong>{homepageConfig.bilibili.name}</strong>
                </div>
                <div class="owner-card-body">
                  <img
                    src={homepageConfig.bilibili.avatar}
                    alt={`${homepageConfig.bilibili.name} 的头像`}
                    width="72"
                    height="72"
                    loading="lazy"
                    decoding="async"
                  />
                  <p>{homepageConfig.bilibili.description}</p>
                </div>
                <a class="side-card-link is-bilibili" href={homepageConfig.bilibili.url} target="_blank" rel="noopener noreferrer">
                  {homepageConfig.bilibili.button}
                </a>
              </section>
            ) : null
          }

          <section class="side-card glass-panel" data-reveal>
            <div class="side-card-head">
              <span>Announcements</span>
              <strong>站点公告</strong>
            </div>
            <ul class="announcement-list">
              {announcementItems.map((item) => <li>{item}</li>)}
            </ul>
          </section>
        </aside>
      </div>

      <footer class="site-footer">
        <span>{homepageConfig.footer.copyright}</span>
        <span>{homepageConfig.footer.assetNote}</span>
        <span>{homepageConfig.footer.contact}</span>
        <a href="https://github.com/unknnownnn003/rhythm-assets-gallery" target="_blank" rel="noopener noreferrer">GitHub</a>
      </footer>
      </div>
    </main>

    <script is:inline>
      fetch("/api/stats?track", { keepalive: true });
    </script>
    <script type="module" src="/site-effects.js"></script>
  </body>
</html>
